# Booking API. Leave VITE_BOOKING_API_URL unset to use the in-memory mock (demo mode).
# For local development against bookable-agent (pnpm dev:up there), copy to .env.dev (`pnpm dev` runs `vite --mode dev`):
VITE_BOOKING_API_URL=http://localhost:7100/v1
VITE_BOOKING_API_KEY=pk_test_cws_local
VITE_BOOKING_LOCATION_ID=canary-wharf
# Customer sign-in (email code): bookable-staging's customer pool, shared by dev and staging. Printed by
# `pnpm dev:auth:link` / `pnpm stage:seed staging` in bookable-agent. Unset: no sign-in offered.
# VITE_CUSTOMER_POOL_CLIENT_ID=

# Staging (copy to .env.staging; deploy with --mode staging, see README). Values come from
# `pnpm stage:seed staging` in bookable-agent:
# VITE_BOOKING_API_URL=https://<api-id>.execute-api.eu-west-2.amazonaws.com/v1
# VITE_BOOKING_API_KEY=pk_test_…
# VITE_BOOKING_LOCATION_ID=canary-wharf
